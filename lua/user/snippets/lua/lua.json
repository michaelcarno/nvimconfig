{
  "nvim lazy module": {
    "prefix": "nvim-lazy-module",
    "description": "Nvim lazy initial",
    "body": [
      "return {",
      "\"$1\",",
      "event = \"VeryLazy\",",
      "config = function()",
      "$2",
      "end,",
      "keys = {",
      " -- { \"\", function() end, desc =\"\" },",
      "}",
      "}"
    ]
  },
    "nvim lazy module inside": {
        "prefix": "nvim-lazy-module-inside",
        "description": "Nvim lazy initial",
        "body": [
            "{",
          "\"$1\",",
          "event = \"VeryLazy\",",
          "config = function()",
          "$2",
          "end,",
          "keys = {",
          " -- { \"\", function() end, desc =\"\" },",
          "}",
          "},"
          ]
        }

}
